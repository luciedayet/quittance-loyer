# Clé secrète de l'intégration interne Notion (Notion > Settings > Connections > Develop or manage integrations)
# Ne jamais préfixer par NEXT_PUBLIC_ : cette clé ne doit être lue que côté serveur.
NOTION_API_KEY=

# ID des "data sources" des bases Notion utilisées par l'application.
# Ce sont les IDs renvoyés lors de la création des bases (page collection://<id> dans Notion),
# pas nécessairement l'ID de la base visible dans l'URL du navigateur.
NOTION_BAILLEURS_DATA_SOURCE_ID=
NOTION_LOCATAIRES_DATA_SOURCE_ID=

# Optionnel : historique des quittances générées. Si absent, la génération de quittance
# fonctionne normalement mais aucun historique n'est journalisé dans Notion.
NOTION_QUITTANCES_DATA_SOURCE_ID=

# ID de la data source Notion "Utilisateurs" (comptes admin/bailleur).
NOTION_UTILISATEURS_DATA_SOURCE_ID=

# Clé secrète utilisée pour signer les tokens JWT de session.
# Génère une valeur aléatoire avec : openssl rand -base64 32
JWT_SECRET=
